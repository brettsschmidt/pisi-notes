# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# The origin rotating image URLs are built from (/i/<slug>). In production this
# must be the public address recipients' mail clients can reach.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_PROJECT_ID=your-project-ref

# Billing (Stripe). Without these the pricing page still renders and the whole
# app works on the free plan — the upgrade button is simply disabled.
#   STRIPE_SECRET_KEY      sk_live_… / sk_test_…
#   STRIPE_WEBHOOK_SECRET  signing secret for the /api/billing/webhook endpoint
#   STRIPE_PRICE_MONTHLY   Stripe Price id for the $8/mo Pro plan
#   STRIPE_PRICE_YEARLY    Stripe Price id for the $72/yr Pro plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
