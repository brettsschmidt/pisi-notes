# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_PROJECT_ID=your-project-ref

# Web Push (VAPID). Generate with:
#   npx web-push generate-vapid-keys
# Then set both the same public key here AND in NEXT_PUBLIC_… so the client
# can read it (or just rely on /api/push/vapid-key which reads VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the reminder cron must send as `Authorization: Bearer …`.
PUSH_DISPATCH_SECRET=

# Ask Pisi — AI answers grounded in the user's own notes. Without
# ANTHROPIC_API_KEY the feature degrades to a clear "not enabled" state.
ANTHROPIC_API_KEY=
# Optional — overrides the model. Defaults to claude-opus-4-7.
ANTHROPIC_MODEL=

# Billing (Stripe). Without these the pricing page still renders and the whole
# app works on the free plan — the upgrade button is simply disabled.
#   STRIPE_SECRET_KEY      sk_live_… / sk_test_…
#   STRIPE_WEBHOOK_SECRET  signing secret for the /api/billing/webhook endpoint
#   STRIPE_PRICE_MONTHLY   Stripe Price id for the $8/mo Pro plan
#   STRIPE_PRICE_YEARLY    Stripe Price id for the $72/yr Pro plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
